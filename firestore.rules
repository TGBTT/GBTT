rules_version = '2';

// Firestore denies any path that no `match` block allows, so there is no
// catch-all deny at the bottom: in Firestore a request is permitted if ANY
// rule grants it, which means a trailing `allow read, write: if false` cannot
// revoke an allow above it. Unmatched paths are already closed.
//
// Cloud Functions use the Admin SDK and bypass these rules entirely. Anything
// that needs to check capacity, money, or roles is enforced there, not here.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return isSignedIn() ? request.auth.token.role : null;
    }

    function isAdmin() {
      return role() == 'admin';
    }

    // `trainer` is a client the admin has elevated so they can run the
    // schedule in his absence. `substitute` is the old name for the same tier
    // and is still accepted so a token minted before the rename keeps working;
    // that fallback can be removed once no legacy claims exist.
    function isTrainer() {
      return role() == 'trainer' || role() == 'substitute';
    }

    function isStaff() {
      return isAdmin() || isTrainer();
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Read a nested profile field without erroring when the parent map is
    // absent. Touching a missing field aborts rule evaluation and denies the
    // request, which would break otherwise-legitimate writes.
    function profileVal(data, key) {
      return data.get('profile', {}).get(key, null);
    }

    // Fields a member must never be able to write on their own document.
    // `billing` and `membership` feed calculateBillingPeriod, so a member who
    // could edit them could set their own discount or plan rate and invoice
    // themselves nothing. `role` and `status` gate access and approval.
    //
    // `clinical.limitations` is the member's own health notes — they fill those
    // in from Studio. Staff `riskNotes` stay frozen here; only an admin write
    // may change them.
    //
    // Everything else under `profile` — name, phone, contact details — stays the
    // member's own to correct. Nothing server-side reads them for money or
    // access, so a wrong phone number is a wrong phone number, not a privilege.
    function clinicalVal(data, key) {
      return data.get('clinical', {}).get(key, '');
    }

    function clinicalSelfEditOk() {
      let before = resource.data.get('clinical', {});
      let after = request.resource.data.get('clinical', {});
      let changed = after.diff(before).affectedKeys();
      return changed.size() == 0 || changed.hasOnly(['limitations']);
    }

    function selfEditAllowed() {
      return profileVal(request.resource.data, 'role') == profileVal(resource.data, 'role')
        && profileVal(request.resource.data, 'status') == profileVal(resource.data, 'status')
        && request.resource.data.get('billing', null) == resource.data.get('billing', null)
        && request.resource.data.get('membership', null) == resource.data.get('membership', null)
        && clinicalSelfEditOk()
        && clinicalVal(request.resource.data, 'riskNotes') == clinicalVal(resource.data, 'riskNotes');
    }

    // —— Public catalog (class types, exercises, venues, team) ——
    match /catalog/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Class types are their own top-level collection rather than nested under
    // /catalog: a document must sit at an even number of path segments, so
    // `catalog/classTypes/{id}` is a collection path and no document can ever
    // exist there.
    match /classTypes/{classTypeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Exercises are referenced by class types and shown on the public class
    // pages, so they read as widely as the classes that list them.
    match /exercises/{exerciseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // —— Recurring timetable template ——
    match /timetableSlots/{slotId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // —— Concrete week sessions (public summary; roster is a subcollection) ——
    match /sessions/{sessionId} {
      allow read: if true;
      allow create, update: if isStaff();

      // Deleting a session document does NOT delete its roster subcollection,
      // so a direct delete would orphan attendance records that still match
      // the roster collection-group query billing runs on. The removeSession
      // callable deletes only when the roster is empty and archives otherwise,
      // so removal has to go through it.
      allow delete: if false;

      // Members never write roster entries directly: capacity, membership
      // status and the transfer window are enforced by the bookSession /
      // cancelBooking callables. Direct writes would bypass all of it.
      match /roster/{userId} {
        allow read: if isStaff() || isOwner(userId);
        allow write: if isStaff();
      }
    }

    // —— Public site copy (hero, terms, waiver) ——
    match /siteContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // —— Member profiles ——
    match /users/{uid} {
      allow read: if isOwner(uid) || isStaff();

      // Self-registration lands in `pending` with no booking rights until an
      // admin approves. Billing and staff clinical notes may not be self-supplied
      // at create; members add limitations later from Studio.
      allow create: if isOwner(uid)
        && profileVal(request.resource.data, 'status') == 'pending'
        && profileVal(request.resource.data, 'role') == 'member'
        && !('billing' in request.resource.data)
        && !('clinical' in request.resource.data);

      allow update: if isAdmin() || (isOwner(uid) && selfEditAllowed());
      allow delete: if isAdmin();

      // Recurring slot locks are bookings; server-side only.
      match /weeklyLocks/{slotId} {
        allow read: if isOwner(uid) || isStaff();
        allow write: if isAdmin();

        match /skippedWeeks/{weekStart} {
          allow read: if isOwner(uid) || isStaff();
          allow write: if false;
        }
      }

      // The SEQUENCE counter behind a member's recurring calendar invite.
      // Server-only: a client that could lower it could stop their own
      // calendar accepting any further update to the series.
      match /calendarSeries/{slotId} {
        allow read, write: if false;
      }

      match /bookings/{bookingId} {
        allow read: if isOwner(uid) || isStaff();
        allow write: if isStaff();
      }

      match /billingPeriods/{periodId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false;
      }

      match /exceptions/{exceptionId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isAdmin();
      }
    }

    // Staff working notes. Not member data, and nothing is priced off them, so
    // any staff account may keep the list current.
    match /reminders/{reminderId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // A member's open request to move plan. Written only by the callable, which
    // holds the price list the request is validated against; a direct write
    // would let a member name a plan and a price that do not match.
    match /planChangeRequests/{uid} {
      allow read: if isOwner(uid) || isStaff();
      allow write: if false;
    }

    // —— Pricing plans & discounts (signed-in members read; admin writes) ——
    match /pricing/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Per-class rate for each level of commitment, including the casual
    // drop-in rate charged on one-off bookings.
    match /pricingPlans/{planId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /pricingDiscounts/{discountId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // —— Seasons: term dates, closure periods and billing mode ——
    // Members read these to see when a term runs and what it will cost, but
    // only an admin sets the dates, since they determine both how many
    // sessions exist and what a member is charged for them.
    match /seasons/{seasonId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // —— Studio settings, transfer windows, bank details ——
    match /meta/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    /*
     * The transfer window is the one setting members are held to: it decides
     * when a cancellation closes and when a weekly slot is committed for the
     * week. The member app has to show them that deadline before they act, so
     * a signed-in read is granted here rather than leaving the client guessing
     * with a hardcoded default that an admin has since changed.
     *
     * Only this document. Everything else under meta stays staff-only, so bank
     * details added later are not exposed by this.
     */
    match /meta/settings {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // —— Guest passes: server creates; staff reads ——
    match /guestPasses/{code} {
      allow read: if isStaff();
      allow write: if false;
    }

    // —— Admin audit log ——
    match /audit/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Sent broadcasts. Written by the sendBroadcast callable so the record
    // reflects what Apps Script actually accepted, not what was attempted.
    match /outbox/{messageId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
